# ============================================================
# AAF 生产环境前端构建变量
# 此文件提交到仓库，只存放非敏感的公开配置。
# 敏感数据（API Key、密码等）不要放这里，
# 参考 PUBLIC_API_URL 的方式：在 GitHub Secrets 中配置，
# 在 deploy.yml 里用 ${{ secrets.XXX }} 引用。
# ============================================================

# ── API 地址 ──────────────────────────────────────────────
# 敏感/环境相关变量不在此文件配置，可通过 GitHub Secrets 注入。
# 示例：NEXT_PUBLIC_API_URL 在 deploy.yml 中通过 ${{ secrets.PUBLIC_API_URL }} 传入。
# github ci 基于 docker 自动部署时需 GitHub Secrets 中配置 PUBLIC_API_URL。
NEXT_PUBLIC_API_URL=https://aaronzzh.cn

# ── 静态资源 CDN/OSS（可选）─────────────────────────────
# 留空时走本地 public/ 目录；填写后所有静态大文件（HDR/GLB/视频）从 OSS 加载
NEXT_PUBLIC_ASSETS_URL=https://cdn.aaronzzh.cn

# ── 阿里云 ESA AI 验证码 ──────────────────────────────────
# scene_id 和 prefix 会编译进前端 JS，属于公开配置，可提交仓库
# 控制台：https://esa.console.aliyun.com/captcha/configuration
NEXT_PUBLIC_CAPTCHA_ENABLED=false
NEXT_PUBLIC_CAPTCHA_REGION=cn
NEXT_PUBLIC_CAPTCHA_PREFIX=esa-knueno0iqx
NEXT_PUBLIC_CAPTCHA_SCENE_ID=159r82hj

NEXT_PUBLIC_UPLOAD_MODE=oss
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# ── 联系方式（公开展示）─────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=service@xuejiai.com
NEXT_PUBLIC_CONTACT_WECHAT_ID=Aaron-ZZH

# ── 应用基础信息（公开展示）─────────────────────────────
NEXT_PUBLIC_APP_NAME=AAF
NEXT_PUBLIC_APP_DEFAULT_TITLE=AAF - Agentic App Framework
NEXT_PUBLIC_APP_TITLE_TEMPLATE=%s - AAF
NEXT_PUBLIC_APP_DESCRIPTION=多智能体应用开发框架
NEXT_PUBLIC_SITE_URL=https://aaronzzh.cn
