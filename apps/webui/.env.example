# ============================================================
# AAF WebUI 前端环境变量
# 复制为 .env.local 并填写实际值
# ============================================================

# ── API 地址 ─────────────────────────────────────────────
# 前端调用后端的地址（本地开发留空走 proxy）
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── 静态资源 CDN/OSS（可选）─────────────────────────────
# 留空时走本地 public/ 目录；填写后所有静态大文件（HDR/GLB/视频）从 OSS 加载
# 示例：https://your-bucket.oss-cn-hangzhou.aliyuncs.com
NEXT_PUBLIC_ASSETS_URL=

# ── 文件上传链路 ─────────────────────────────────────────
# 上传模式：默认由后端上传
#   oss  — 走阿里云 OSS STS 直传 + 分片，需要后端 STORAGE_TYPE=oss 并配置 OSS_*
# 切到 oss 后，前端调 GET /api/system/files/sts-token 拿临时凭证，
# 用 ali-oss SDK multipartUpload 直传到 OSS，绕过 Next.js
NEXT_PUBLIC_UPLOAD_MODE=

# ── 开发工具 ─────────────────────────────────────────────
# 压制 @serwist/next 的 Turbopack 不兼容警告（开发环境 serwist 已通过 disable 配置禁用，警告无实际影响）
SERWIST_SUPPRESS_TURBOPACK_WARNING=1


# ── 阿里云 ESA AI 验证码（可选）─────────────────────────────
# 需域名接入阿里云 ESA 才有效；本地开发保持 false
# 控制台：https://esa.console.aliyun.com/captcha/configuration
NEXT_PUBLIC_CAPTCHA_ENABLED=false
NEXT_PUBLIC_CAPTCHA_REGION=cn
NEXT_PUBLIC_CAPTCHA_PREFIX=           # 身份标（控制台右上角获取）
NEXT_PUBLIC_CAPTCHA_SCENE_ID=         # 场景ID（规则列表中获取）

# ── 联系方式（公开展示）─────────────────────────────────
# 用于联系页、定价页等面向用户的页面展示，留空回退到代码中的默认值
NEXT_PUBLIC_CONTACT_EMAIL=service@xuejiai.com
NEXT_PUBLIC_CONTACT_WECHAT_ID=Aaron-ZZH

# ── 应用基础信息（公开展示）─────────────────────────────
# 用于 Brand 组件、页面 SEO、manifest/sitemap 等场景，留空回退到代码中的默认值
NEXT_PUBLIC_APP_NAME=AAF
NEXT_PUBLIC_APP_DEFAULT_TITLE=AAF - Agentic App Framework
# 子页面标题模板，%s 会被替换为页面名
NEXT_PUBLIC_APP_TITLE_TEMPLATE=%s - AAF
NEXT_PUBLIC_APP_DESCRIPTION=多智能体应用开发框架
# 站点 URL（用于 sitemap / robots / Open Graph）
NEXT_PUBLIC_SITE_URL=https://aaf.xuejiai.com
