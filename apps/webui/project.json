{
  "name": "webui",
  "projectType": "application",
  "sourceRoot": "apps/webui/src",
  "targets": {
    "build": {
      "command": "next build",
      "options": { "cwd": "apps/webui" },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/next.config.ts", "{projectRoot}/tsconfig.json", "{projectRoot}/postcss.config.mjs"],
      "outputs": ["{projectRoot}/.next"]
    },
    "dev": {
      "command": "next dev --turbopack",
      "options": { "cwd": "apps/webui" },
      "continuous": true
    },
    "start": {
      "command": "next start",
      "options": { "cwd": "apps/webui" },
      "continuous": true
    },
    "typecheck": {
      "command": "tsgo --noEmit -p tsconfig.json",
      "options": { "cwd": "apps/webui" },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig.json", "{projectRoot}/next-env.d.ts"]
    },
    "lint": {
      "command": "biome check apps/webui/src",
      "inputs": ["{projectRoot}/src/**/*", "{workspaceRoot}/biome.json"]
    },
    "test": {
      "command": "vitest run --passWithNoTests",
      "options": { "cwd": "apps/webui" },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/vitest.config.ts"]
    },
    "acceptance": {
      "command": "vitest run --config vitest.acceptance.config.ts --passWithNoTests",
      "options": { "cwd": "apps/webui" }
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
