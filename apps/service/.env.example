# ============================================================
# AAF 环境变量配置示例
# 复制为 .env 并填写实际值，.env 已加入 .gitignore
# ============================================================

# ── 应用 / 站点（生产必须按真实域名配置）─────────────────
# 前端访问地址：用于 CORS 放行域 + 后端回跳；不设则回落 http://localhost:3000，生产 CORS 会拒绝真实域名
AAF_WEB_ORIGIN=http://localhost:3000
# 文件外链域名前缀：生产需设为对外可访问域名，否则文件 URL 为 localhost:8080
AAF_FILE_DOMAIN=http://localhost:8080
AAF_COMPANY_NAME=学记智能

# ── 数据库（PostgreSQL）────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aaf-dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Neo4j ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────
# ⚠️ 生产必须改为强随机值（≥32 字节），切勿沿用下面的 dev 默认值
JWT_SECRET=aaf-dev-secret-must-be-at-least-32-bytes-long!!
JWT_EXPIRE_SECONDS=604800

# ── 邮件（SMTP）──────────────────────────────────────────
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=your-smtp-auth-code
EMAIL_FROM=noreply@xuejiai.com
# 邮件 E2E 测试收件地址（默认与 EMAIL_FROM 相同）
TEST_EMAIL=

# ── AI（OpenAI 兼容接口）─────────────────────────────────
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# ── AI（阿里云 DashScope / AgentScope）──────────────────
# AgentScope 示例和 DashScope 模型需要此 key
# 启用 AgentScope 示例：取消 application-dev.yaml 中 aaf.examples.agentscope.enabled 的注释
DASHSCOPE_API_KEY=
MCP_SERVER_URL=
MCP_TRANSPORT=streamable-http

# ── 文件存储 ──────────────────────────────────────────────
# 存储类型：local（本地）/ s3（MinIO/AWS S3 兼容）/ oss（阿里云原生，支持 STS 分片直传）
STORAGE_TYPE=local

# ── 本地存储（STORAGE_TYPE=local 生效）─────────────────────
# 文件落盘根路径
AAF_FILE_PATH=${user.home}/aaf-files

# ── S3 / MinIO（STORAGE_TYPE=s3 生效）─────────────────────
# MinIO 开发环境示例：http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aaf
S3_REGION=cn-hangzhou
# 旧字段，向下兼容；S3_ACCESS_KEY/S3_SECRET_KEY 未设时回退使用
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── 阿里云 OSS（STORAGE_TYPE=oss 生效，支持前端 STS 直传分片）──
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
# RAM 用户长期凭证（仅用于服务端调用 STS，不会下发给前端）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# RAM 角色 ARN，前端直传分片上传必需，格式：acs:ram::<uid>:role/<role-name>
OSS_ROLE_ARN=
OSS_STS_ENDPOINT=sts.aliyuncs.com
# 对象访问 URL 前缀（可选）；留空则使用 https://<bucket>.<endpoint>/<key>
OSS_URL_PREFIX=
# STS 凭证有效期（秒），最小 900，默认 3600
OSS_DURATION_SECONDS=3600

# ── 短信（可选，dev 默认不启用）─────────────────────────
# 需要短信功能时取消 application-dev.yaml 中的注释并填写以下值
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=AAF
# 注意：签名含中文时须用 Unicode 转义，例如：SMS_SIGN_NAME=\u5b66\u8bb0AI

# ── OAuth 第三方登录（可选）──────────────────────────────
# 微信
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/oauth/wechat/redirect

# 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=https://your-domain.com/api/auth/oauth/wecom/redirect

# 钉钉
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_REDIRECT_URI=https://your-domain.com/api/auth/oauth/dingtalk/redirect


# ── MCP 工具服务器（可选）────────────────────────────────────────
# 留空则 mcpToolAgent 以无工具模式运行
# 传输类型：sse | streamable-http
# 示例（NWS 天气，免费无需认证，仅覆盖美国地区）：
MCP_SERVER_URL=https://nws.caseyjhand.co
MCP_TRANSPORT=streamable-http


# ── 演示模式 ──────────────────────────────────────────────
# true 时注册 /api/system/demo/load 和 /clean 接口
# dev 环境已默认开启，生产环境保持 false
AAF_DEMO_ENABLED=false

# ── License 授权（框架商业授权）──────────────────────────
# 私钥文件路径，用于签发 license.jwt（官方运营人员配置，普通部署无需设置）
AAF_LICENSE_KEY_FILE=~/.aaf/signing.key

# ── 天气（彩云天气 v2.6）────────────────────────────────
# 在 https://platform.caiyunapp.com 注册后获取 App Key 和 App Secret
CAIYUN_APP_KEY=
CAIYUN_APP_SECRET=

# ── 支付宝支付 ────────────────────────────────────────────
# 支付宝开放平台：https://open.alipay.com
# 沙箱环境：https://openhome.alipay.com/develop/sandbox/app
# 正式环境网关：https://openapi.alipay.com/gateway.do
# 沙箱环境网关：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_ENABLED=false
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=9021000165620830
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 支付宝异步回调地址（生产环境需配置为公网可访问域名）
ALIPAY_NOTIFY_URL=http://localhost:8080/api/pay/orders/notify/alipay
# 支付宝同步跳转地址（支付完成后跳转到前端落地页，携带 out_trade_no 参数）
ALIPAY_RETURN_URL=http://localhost:3000/pay-result
