# ============================================================
# AAF 环境变量配置示例
# 复制为 .env 并填写实际值，.env 已加入 .gitignore
# ============================================================

# ── 数据库（PostgreSQL）────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aaf-dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Neo4j ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=aaf-dev-secret-must-be-at-least-32-bytes-long!!
JWT_EXPIRE_SECONDS=7200

# ── 邮件（SMTP）──────────────────────────────────────────
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=your-smtp-auth-code
EMAIL_FROM=noreply@xuejiai.com

# ── AI（OpenAI 兼容接口）─────────────────────────────────
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# ── 文件存储 ──────────────────────────────────────────────
# STORAGE_TYPE=local | s3
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/data/aaf-files

# ── 短信（阿里云）────────────────────────────────────────
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=AAF

# ── OAuth 第三方登录 ──────────────────────────────────────
# 微信
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:3000/auth/callback/wechat

# 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=http://localhost:3000/auth/callback/wecom

# 钉钉
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:3000/auth/callback/dingtalk
