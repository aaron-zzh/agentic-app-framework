<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.xuejiai</groupId>
		<artifactId>aaf</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>aaf-framework</artifactId>
	<name>AAF Framework</name>
	<description>核心框架：引擎层 + 智能层，可复用的 AI 原生能力</description>

	<dependencies>
		<dependency>
			<groupId>com.xuejiai</groupId>
			<artifactId>aaf-common</artifactId>
		</dependency>

		<!-- Web -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- 数据访问 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- AOP -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<!-- 可观测性 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-health</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>

		<!-- 安全 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- 工具 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>

		<!-- 消息服务 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.freemarker</groupId>
			<artifactId>freemarker</artifactId>
		</dependency>
		<!-- TODO: 短信 SDK 暂未在镜像仓库可用，待解决 -->
		<dependency>
			<groupId>com.aliyun</groupId>
			<artifactId>dysmsapi20170525</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.tencentcloudapi</groupId>
			<artifactId>tencentcloud-sdk-java-sms</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.aliyun</groupId>
			<artifactId>imageenhan20190930</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- AI -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-openai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
		</dependency>
		<!-- ===== AgentScope 2.0+ ===== -->
		<!-- 核心：HarnessAgent（自动传递 agentscope-core） -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-harness</artifactId>
			<exclusions>
				<!-- 排除 Jackson 2.x 的 jsonschema（Spring AI 需要 5.0.0/Jackson 3.x） -->
				<exclusion>
					<groupId>com.github.victools</groupId>
					<artifactId>jsonschema-generator</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.github.victools</groupId>
					<artifactId>jsonschema-module-jackson</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- AG-UI 协议官方扩展：starter 自动暴露 /agui/run/{agentId} 端点 -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-agui-spring-boot-starter</artifactId>
		</dependency>
		<!-- 可选扩展（按需启用） -->
		<!-- Skill PostgreSQL 仓库：与 AAF ai_skill_definition 表对接 -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-skill-postgresql-repository</artifactId>
		</dependency>
		<!-- Redis BaseStore：harness 线程队列/元数据后端 -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-redis</artifactId>
		</dependency>
		<!-- OSS BaseStore：大对象（生成内容快照）后端 -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-oss</artifactId>
		</dependency>
		<!-- Channel 公共接口（HarnessGateway 用） -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-channel-common</artifactId>
		</dependency>

		<!-- DashScope SDK：HarnessAgent 默认 model provider 之一 -->
		<dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>dashscope-sdk-java</artifactId>
		</dependency>
		<!-- 响应式：agentscope-core 的 Mono/Flux 流 -->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-core</artifactId>
		</dependency>

		<!-- ===== 以下 1.x 旧依赖暂保留注释，避免 1.0 集成代码误编译 =====
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-a2a-spring-boot-starter</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.jboss.slf4j</groupId>
					<artifactId>slf4j-jboss-logmanager</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-reme</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-autocontext-memory</artifactId>
		</dependency>
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-session-redis</artifactId>
		</dependency>
		===== -->

		<!-- 图数据库 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-neo4j</artifactId>
		</dependency>

		<!-- 文档解析 -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
		</dependency>

		<!-- 存储 -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.aliyun.oss</groupId>
			<artifactId>aliyun-sdk-oss</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.aliyun</groupId>
			<artifactId>aliyun-java-sdk-sts</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.aliyun</groupId>
			<artifactId>aliyun-java-sdk-core</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>net.coobird</groupId>
			<artifactId>thumbnailator</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- 缓存 -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- 工作流引擎 -->
		<dependency>
			<groupId>org.flowable</groupId>
			<artifactId>flowable-spring-boot-starter</artifactId>
		</dependency>

		<!-- 支付 SDK（可选，配置开关控制） -->
		<dependency>
			<groupId>com.github.binarywang</groupId>
			<artifactId>weixin-java-pay</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- 企业微信 SDK（可选） -->
		<dependency>
			<groupId>com.github.binarywang</groupId>
			<artifactId>weixin-java-cp</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.alipay.sdk</groupId>
			<artifactId>alipay-sdk-java</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- 脚本沙箱（GraalVM Polyglot，可选） -->
		<dependency>
			<groupId>org.graalvm.polyglot</groupId>
			<artifactId>polyglot</artifactId>
			<version>24.1.1</version>
		</dependency>
		<dependency>
			<groupId>org.graalvm.polyglot</groupId>
			<artifactId>js</artifactId>
			<version>24.1.1</version>
			<type>pom</type>
		</dependency>

		<!-- 操作日志 diff（bizlog 移植自 mzt-biz-log） -->
		<dependency>
			<groupId>de.danielbechler</groupId>
			<artifactId>java-object-diff</artifactId>
		</dependency>

		<!-- 测试 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- 排除 1.x agentscope 集成代码（保留源码不删除，仅不参与 2.0+ 编译） -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<excludes>
						<!-- 1.0 AgentScope 集成（runtime/hook/memory/session/tool/knowledge/a2a） -->
						<exclude>com/xuejiai/aaf/framework/intelligent/agentscope/**</exclude>
						<exclude>com/xuejiai/aaf/framework/intelligent/assistant/a2a/**</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
