{
  "name": "service",
  "projectType": "application",
  "sourceRoot": "apps/service/aaf-api/src",
  "targets": {
    "build": {
      "command": "mvnw package -DskipTests",
      "options": { "cwd": "apps/service" },
      "inputs": ["{projectRoot}/**/src/**/*", "{projectRoot}/**/pom.xml"],
      "outputs": ["{projectRoot}/**/target"]
    },
    "serve": {
      "command": "mvnw install -DskipTests -q && mvnw spring-boot:run -f aaf-api/pom.xml",
      "options": { "cwd": "apps/service" },
      "continuous": true
    },
    "lint": {
      "command": "mvnw com.diffplug.spotless:spotless-maven-plugin:check",
      "options": { "cwd": "apps/service" },
      "inputs": ["{projectRoot}/**/src/**/*.java", "{projectRoot}/**/pom.xml"]
    },
    "format": {
      "command": "mvnw com.diffplug.spotless:spotless-maven-plugin:apply",
      "options": { "cwd": "apps/service" }
    },
    "test": {
      "command": "mvnw test",
      "options": { "cwd": "apps/service" },
      "inputs": ["{projectRoot}/**/src/**/*", "{projectRoot}/**/pom.xml"],
      "outputs": ["{projectRoot}/**/target/surefire-reports"]
    },
    "acceptance": {
      "command": "mvnw verify -DskipITs=false",
      "options": { "cwd": "apps/service" },
      "inputs": ["{projectRoot}/**/src/**/*", "{projectRoot}/**/pom.xml"],
      "outputs": ["{projectRoot}/**/target/failsafe-reports"]
    },
    "check": {
      "executor": "nx:noop"
    },
    "clean": {
      "command": "mvnw clean",
      "options": { "cwd": "apps/service" }
    }
  }
}
