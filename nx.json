{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/**/*.yml",
      "!{projectRoot}/**/*.yaml"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.accept.test.*",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "test": [
      "{projectRoot}/src/**/*.ts",
      "{projectRoot}/src/**/*.tsx",
      "{projectRoot}/src/**/*.java",
      "{projectRoot}/**/__tests__/**",
      "{projectRoot}/**/*.test.*",
      "{projectRoot}/**/*.spec.*"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "include": ["apps/*"],
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/vitest",
      "include": ["apps/webui", "packages/hooks", "packages/core"],
      "exclude": ["apps/uniapp"],
      "options": {
        "testTargetName": "vitest:test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "analytics": false,
  "release": {
    "projects": ["core", "hooks"],
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "CHANGELOG.md",
        "createRelease": "github"
      }
    }
  },
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "none"
      }
    }
  },
  "sync": {
    "applyChanges": "all-files"
  },
  "projects": {
    "webui": { "tags": ["scope:app", "type:app"] },
    "service": { "tags": ["scope:app", "type:service"] },
    "core": { "tags": ["scope:shared", "type:util"] },
    "hooks": { "tags": ["scope:shared", "type:util"] }
  },
  "moduleBoundaries": {
    "rules": [
      {
        "sourceTag": "scope:app",
        "onlyDependOnLibsWithTags": ["scope:app", "scope:shared"]
      },
      {
        "sourceTag": "scope:shared",
        "onlyDependOnLibsWithTags": ["scope:shared"]
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["test", "^production"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "test", "build", "publint"]
    }
  }
}
