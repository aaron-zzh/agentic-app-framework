{
  "name": "knowledge-visualization",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/knowledge-visualization/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:feature"
  ],
  "// targets": "to see all targets run: nx show project knowledge-visualization --web",
  "targets": {
    "build": {
      "command": "tsc -p tsconfig.lib.json",
      "options": {
        "cwd": "packages/knowledge-visualization"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "tsgo --noEmit -p tsconfig.lib.json",
      "options": {
        "cwd": "packages/knowledge-visualization"
      }
    },
    "lint": {
      "command": "biome check packages/knowledge-visualization/src"
    },
    "publint": {
      "command": "publint",
      "options": {
        "cwd": "packages/knowledge-visualization"
      },
      "dependsOn": ["build"]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["lint", "typecheck", "build", "publint"]
    }
  }
}
