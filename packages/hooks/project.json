{
  "name": "hooks",
  "projectType": "library",
  "sourceRoot": "packages/hooks/src",
  "tags": ["scope:shared", "type:util"],
  "targets": {
    "build": {
      "command": "tsc -p tsconfig.lib.json",
      "options": { "cwd": "packages/hooks" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "tsgo --noEmit -p tsconfig.lib.json",
      "options": { "cwd": "packages/hooks" }
    },
    "test": {
      "command": "vitest run",
      "options": { "cwd": "packages/hooks" }
    },
    "lint": {
      "command": "biome check packages/hooks/src"
    },
    "publint": {
      "command": "publint",
      "options": { "cwd": "packages/hooks" },
      "dependsOn": ["build"]
    }
  }
}
