map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream aaf_webui {
    server ${AAF_WEBUI_UPSTREAM};
    keepalive 32;
}

upstream aaf_api {
    server ${AAF_API_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    server_name ${AAF_SERVER_NAME};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${AAF_SERVER_NAME};

    ssl_certificate ${AAF_SSL_CERTIFICATE};
    ssl_certificate_key ${AAF_SSL_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size ${AAF_CLIENT_MAX_BODY_SIZE};

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://aaf_webui;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    location /api/ {
        proxy_pass http://aaf_api/api/;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
    }

    location /ws/ {
        proxy_pass http://aaf_api/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /agui/ {
        proxy_pass http://aaf_api/agui/;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }

    location /actuator/ {
        allow 127.0.0.1;
        allow ${AAF_MONITOR_ALLOW_CIDR};
        deny all;

        proxy_pass http://aaf_api/actuator/;
        proxy_http_version 1.1;
    }
}
